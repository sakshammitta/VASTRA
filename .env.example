# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Cloudflare R2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=<your-access-key-id>
R2_SECRET_KEY=<your-secret-access-key>
R2_BUCKET=vastra
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# JWT (use a long random string in production)
JWT_SECRET=local-dev-secret-change-in-production-must-be-32-chars-min

# ── Clean-image services (optional) ──────────────────────────────────────────
# Leave BLANK to keep a service disabled. When blank, the app shows the
# "not enabled yet" state and makes NO external/paid calls.

# OpenAI AI clean-image render (images/edits, grounded in the garment crop).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# SerpAPI Google Lens product matching. Leave blank to keep web matching OFF.
SERPAPI_KEY=
